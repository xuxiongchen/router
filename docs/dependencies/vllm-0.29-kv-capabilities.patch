@@ -0,0 +1,34 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Proposed fixed control-plane API, not an arbitrary utility-RPC proxy."""
+
+import asyncio
+
+from fastapi import APIRouter, FastAPI, Request
+from fastapi.responses import JSONResponse
+
+router = APIRouter()
+
+
+@router.get("/v1/kv-cache/capabilities", include_in_schema=False)
+async def get_kv_cache_capabilities(request: Request):
+    config = request.app.state.vllm_config.kv_events_config
+    if config is None or not config.enable_capabilities:
+        return JSONResponse({"error": "capability export is disabled"}, status_code=404)
+    try:
+        result = await asyncio.wait_for(
+            request.app.state.engine_client.get_kv_cache_capabilities(), timeout=5.0
+        )
+    except TimeoutError:
+        # The deadline abandons this HTTP response, not the engine operation.
+        return JSONResponse({"error": "capability export timed out"}, status_code=503)
+    except NotImplementedError:
+        return JSONResponse({"error": "unsupported engine client"}, status_code=409)
+    if "unsupported" in result:
+        return JSONResponse(result, status_code=409)
+    return JSONResponse(result)
+
+
+def attach_router(app: FastAPI):
+    # /v1 is covered by the existing bearer middleware when API keys are set.
+    app.include_router(router)
