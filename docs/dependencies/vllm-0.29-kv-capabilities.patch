diff --git a/vllm/v1/engine/kv_capabilities.py b/vllm/v1/engine/kv_capabilities.py
new file mode 100644
index 0000000..5239dcb
--- /dev/null
+++ b/vllm/v1/engine/kv_capabilities.py
@@ -0,0 +1,297 @@
+# SPDX-License-Identifier: Apache-2.0
+# SPDX-FileCopyrightText: Copyright contributors to the vLLM project
+"""Proposed v1 capability adapter for an initialized, static, local Dense cache.
+
+This is deliberately not a model catalogue. Unsupported effective mechanisms
+are denied. Online model/config/weight mutations require full Worker and Router
+restart; a publisher boot epoch is not an online mutation detector.
+"""
+
+import inspect
+from typing import Any
+
+
+class UnsupportedCapability(ValueError):
+    pass
+
+
+def _require(condition: bool, reason: str) -> None:
+    if not condition:
+        raise UnsupportedCapability(reason)
+
+
+def export_kv_cache_capabilities(engine: Any) -> dict[str, Any]:
+    """Return serializable effective facts or an explicit unsupported result.
+
+    Never scans cached blocks, calls hit lookup, or mutates allocator/LRU state.
+    The utility RPC preserves this result shape across process boundaries.
+    """
+    try:
+        return _export(engine)
+    except (UnsupportedCapability, AttributeError, TypeError, ValueError):
+        # Do not expose paths/config contents through exception messages.
+        return {"unsupported": "effective runtime is outside normal_full_attention v1"}
+
+
+def _export(engine: Any) -> dict[str, Any]:
+    # Lazy imports avoid the EngineCore/Scheduler import cycle. Identity checks
+    # intentionally do not grant custom classes their base class's semantics.
+    from vllm import envs
+    from vllm.distributed.kv_events import ZmqEventPublisher
+    from vllm.utils.hashing import sha256_cbor
+    from vllm.v1.core import kv_cache_utils
+    from vllm.v1.core.kv_cache_coordinator import UnitaryKVCacheCoordinator
+    from vllm.v1.core.kv_cache_manager import KVCacheManager
+    from vllm.v1.core.sched.async_scheduler import AsyncScheduler
+    from vllm.v1.core.sched.scheduler import Scheduler
+    from vllm.v1.core.single_type_kv_cache_manager import FullAttentionManager
+    from vllm.v1.kv_cache_interface import FullAttentionSpec, UniformTypeKVCacheSpecs
+    from vllm.version import __version__
+
+    _require(__version__.split("+")[0] == "0.29.0", "unsupported package API")
+    config = engine.vllm_config
+    _require(config.kv_events_config.enable_capabilities, "disabled")
+    scheduler = engine.scheduler
+    _require(type(scheduler) in (Scheduler, AsyncScheduler), "unknown scheduler")
+    cache = scheduler.kv_cache_manager
+    _require(type(cache) is KVCacheManager, "unknown cache manager")
+    coordinator = cache.coordinator
+    _require(type(coordinator) is UnitaryKVCacheCoordinator, "unknown coordinator")
+    groups = scheduler.kv_cache_config.kv_cache_groups
+    metadata = engine.get_kv_cache_group_metadata()
+    _require(
+        len(groups) == len(metadata) == len(coordinator.single_type_managers) == 1,
+        "incomplete group inventory",
+    )
+    group = groups[0]
+    manager = coordinator.single_type_managers[0]
+    spec = group.kv_cache_spec
+    _require(type(manager) is FullAttentionManager, "unknown manager")
+    _require(type(spec) is FullAttentionSpec, "unknown spec")
+    _require(
+        manager.kv_cache_spec is spec and coordinator.kv_cache_spec is spec,
+        "contradictory spec",
+    )
+    _require(
+        group.layer_names and len(set(group.layer_names)) == len(group.layer_names),
+        "empty/incomplete layers",
+    )
+    _require(
+        not group.is_eagle_group
+        and spec.sliding_window is None
+        and spec.attention_chunk_size is None
+        and not spec.non_causal,
+        "non-ordinary attention",
+    )
+    _require(
+        metadata
+        == [
+            {
+                "group_idx": 0,
+                "kind": "full_attention",
+                "block_size": spec.block_size,
+                "sliding_window": None,
+            }
+        ],
+        "contradictory group export",
+    )
+    block = spec.block_size
+    # The scheduler config has discarded all but the first member of a uniform
+    # wrapper. Confirm every original worker leaf before granting semantics.
+    source_groups = engine._kv_capability_source_groups
+    _require(
+        len(source_groups) == 1 and len(source_groups[0]) == 1,
+        "incomplete worker inventory",
+    )
+    source_names, source_spec = source_groups[0][0]
+    _require(source_names == tuple(group.layer_names), "inconsistent worker layers")
+    if type(source_spec) is UniformTypeKVCacheSpecs:
+        _require(
+            set(source_spec.kv_cache_specs) == set(source_names),
+            "incomplete uniform inventory",
+        )
+        leaves = tuple(source_spec.kv_cache_specs.values())
+    else:
+        leaves = (source_spec,)
+    _require(
+        leaves
+        and all(
+            type(leaf) is FullAttentionSpec
+            and leaf.block_size == block
+            and leaf.sliding_window is None
+            and leaf.attention_chunk_size is None
+            and not leaf.non_causal
+            for leaf in leaves
+        ),
+        "unsupported hidden worker leaf",
+    )
+    units = (
+        manager.block_size,
+        manager.scheduler_block_size,
+        manager.cache_hit_alignment_tokens,
+        coordinator.block_size,
+        coordinator.scheduler_block_size,
+        scheduler.block_size,
+        scheduler.hash_block_size,
+        coordinator.block_pool.hash_block_size,
+    )
+    _require(
+        type(block) is int and 1 <= block <= 65536 and all(x == block for x in units),
+        "unsupported units",
+    )
+    _require(
+        manager.kv_cache_group_id == 0
+        and manager.block_pool is cache.block_pool
+        and coordinator.block_pool is cache.block_pool,
+        "inconsistent ownership",
+    )
+    _require(
+        cache.enable_caching
+        and coordinator.enable_caching
+        and manager.enable_caching
+        and config.cache_config.enable_prefix_caching
+        and cache.enable_kv_cache_events
+        and scheduler.enable_kv_cache_events,
+        "cache/events disabled",
+    )
+    _require(
+        not cache.use_eagle
+        and not coordinator.eagle_group_ids
+        and not manager.use_eagle
+        and not scheduler.use_eagle
+        and scheduler.num_prefill_lookahead == 0
+        and coordinator.num_reprefillable_tokens == 0
+        and not engine.use_spec_decode
+        and config.speculative_config is None,
+        "speculation",
+    )
+    parallel = config.parallel_config
+    parallel_sizes = (
+        parallel.data_parallel_size,
+        parallel.tensor_parallel_size,
+        parallel.pipeline_parallel_size,
+        parallel.decode_context_parallel_size,
+        parallel.prefill_context_parallel_size,
+        manager.dcp_world_size,
+        manager.pcp_world_size,
+        scheduler.dcp_world_size,
+        scheduler.pcp_world_size,
+    )
+    _require(
+        all(x == 1 for x in parallel_sizes) and parallel.data_parallel_index == 0,
+        "parallel execution",
+    )
+    _require(
+        scheduler.connector is None
+        and scheduler.ec_connector is None
+        and config.kv_transfer_config is None
+        and config.ec_transfer_config is None
+        and config.cache_config.kv_offloading_size in (None, 0),
+        "transfer/offload",
+    )
+    _require(
+        config.offload_config.uva.cpu_offload_gb == 0
+        and config.offload_config.prefetch.offload_group_size == 0,
+        "weight offload",
+    )
+    model = config.model_config
+    _require(
+        model.runner_type == "generate"
+        and not model.is_encoder_decoder
+        and not model.is_diffusion
+        and model.multimodal_config is None
+        and config.lora_config is None
+        and config.weight_transfer_config is None
+        and engine._weight_version == "default",
+        "non-static text serving",
+    )
+    _require(
+        config.cache_config.prefix_caching_hash_algo == "sha256_cbor"
+        and not envs.VLLM_KV_EVENTS_USE_INT_BLOCK_HASHES,
+        "hash representation",
+    )
+    seed_text = kv_cache_utils.get_none_hash_seed()
+    _require(
+        seed_text.isascii()
+        and seed_text.isdecimal()
+        and str(int(seed_text)) == seed_text
+        and 0 <= int(seed_text) <= 0xFFFFFFFF,
+        "unsupported hash seed",
+    )
+    root = kv_cache_utils.NONE_HASH
+    _require(
+        type(root) is bytes and len(root) == 32 and root == sha256_cbor(seed_text),
+        "root seed mismatch",
+    )
+    hasher = engine.request_block_hasher
+    _require(inspect.isfunction(hasher), "unknown hasher")
+    reference = kv_cache_utils.get_request_block_hasher(block, sha256_cbor)
+    closure = inspect.getclosurevars(hasher).nonlocals
+    _require(
+        hasher.__code__ is reference.__code__
+        and closure.get("caching_hash_fn") is sha256_cbor
+        and closure.get("hash_block_size") == block,
+        "unknown hasher",
+    )
+    publisher = scheduler.kv_event_publisher
+    _require(type(publisher) is ZmqEventPublisher, "unknown publisher")
+    binding = publisher.get_capability_binding()
+    _require(
+        binding["dp_rank"] == parallel.data_parallel_index, "publisher rank mismatch"
+    )
+    names = model.served_model_name or [model.model]
+    if isinstance(names, str):
+        names = [names]
+    _require(
+        names and all(type(x) is str and x for x in names), "empty served namespace"
+    )
+    return {
+        "schema_version": 1,
+        "vllm_version": __version__.split("+")[0],
+        "mechanism": "normal_full_attention",
+        "mechanism_version": 1,
+        "namespace": {
+            "model": model.model,
+            "served_model_names": names,
+            "revision": model.revision,
+            "dtype": str(model.dtype),
+            "quantization": model.quantization,
+            "cache_dtype": config.cache_config.cache_dtype,
+            "weight_version": engine._weight_version,
+        },
+        "groups": [
+            {
+                "group_id": 0,
+                "kind": "full_attention",
+                "layer_count": len(group.layer_names),
+                "allocation_block_tokens": block,
+                "effective_block_tokens": manager.block_size,
+            }
+        ],
+        "hash": {
+            "algorithm": "sha256_cbor",
+            "width_bytes": 32,
+            "representation": "bytes",
+            "seed": int(seed_text),
+            "root_hex": root.hex(),
+            "extra_keys": "none",
+            "block_tokens": scheduler.hash_block_size,
+        },
+        "reuse": {
+            "alignment_tokens": coordinator.block_size,
+            "terminal_recompute_tokens": 1,
+        },
+        "execution": {
+            "mode": "normal",
+            "dp": 1,
+            "tp": 1,
+            "pp": 1,
+            "dcp": 1,
+            "pcp": 1,
+            "prefix_caching": True,
+            "speculation": False,
+            "connector": False,
+            "offload": False,
+        },
+        "events": binding,
+    }
